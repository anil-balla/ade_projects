{
	"name": "pipeline3",
	"properties": {
		"activities": [
			{
				"name": "GetMetadata_sales",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "csv_dataset",
						"type": "DatasetReference",
						"parameters": {
							"param1": {
								"value": "@concat('daily_sales_', pipeline().parameters.date, '.csv')",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"exists",
						"size",
						"structure"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "LKP_control_table",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "GetMetadata_sales",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select allow_load from sales_control where business_date =\n '@{pipeline().parameters.date}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_DBCON",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "vExpected_columns",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "LKP_control_table",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "expected_columns",
					"value": [
						"store_id",
						"amount",
						"sale_date"
					]
				}
			},
			{
				"name": "Filters",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "vExpected_columns",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GetMetadata_sales').output.structure",
						"type": "Expression"
					},
					"condition": {
						"value": "@not(contains(variables('expected_columns'), item().name))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Filters",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@and(\n    and(\n        activity('GetMetadata_sales').output.exists,\n        greater(activity('GetMetadata_sales').output.size, 0)\n    ),\n    and(\n        equals(activity('LKP_control_table').output.firstRow.allow_load, 'yes'),\n        equals(length(activity('Filters').output.value), 0)\n    )\n)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail_Message",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('Validation failed for the file daily_sales_',pipeline().parameters.date,'.csv')",
									"type": "Expression"
								},
								"errorCode": {
									"value": "Validation Failed",
									"type": "Expression"
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Copy data1",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false,
									"disableMetricsCollection": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "csv_dataset",
									"type": "DatasetReference",
									"parameters": {
										"param1": {
											"value": "@concat('daily_sales_',pipeline().parameters.date,'.csv')",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "AzureSql_insert",
									"type": "DatasetReference"
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"date": {
				"type": "string",
				"defaultValue": "2025-11-18"
			}
		},
		"variables": {
			"expected_columns": {
				"type": "Array"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-16T12:25:07Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}
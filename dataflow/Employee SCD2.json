{
	"name": "Employee SCD2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dataflow",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable2",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable2",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable2",
						"type": "DatasetReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "exists1"
				},
				{
					"name": "select2"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "exists2"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "alterRow2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as short,",
				"          first_name as string,",
				"          last_name as string,",
				"          city as string,",
				"          start_date as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          id as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          city as string,",
				"          start_date as date,",
				"          end_date as date,",
				"          active_flag as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1 select(mapColumn(",
				"          id,",
				"          first_name,",
				"          last_name,",
				"          city,",
				"          start_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, select2 exists(select1@id == select2@id \r",
				"&& select1@first_name == select2@first_name \r",
				"&& select1@last_name == select2@last_name \r",
				"&& select1@city == select2@city,",
				"     negate:true,",
				"     broadcast: 'auto')~> exists1",
				"filter1 select(mapColumn(",
				"          id,",
				"          first_name,",
				"          last_name,",
				"          city,",
				"          start_date,",
				"          end_date,",
				"          active_flag",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"exists1 derive(end_date = toDate(\"2099-12-31\"),",
				"          active_flag = 1) ~> derivedColumn1",
				"derivedColumn1 alterRow(insertIf(1==1)) ~> alterRow1",
				"source2 filter(active_flag == 1) ~> filter1",
				"select2, exists1 exists(select2@id == select1@id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists2",
				"exists2 derive(end_date = toDate(currentTimestamp()),",
				"          active_flag = 0) ~> derivedColumn2",
				"derivedColumn2 alterRow(updateIf(1==1)) ~> alterRow2",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          city as string,",
				"          start_date as date,",
				"          end_date as date,",
				"          active_flag as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          id,",
				"          first_name,",
				"          last_name,",
				"          city,",
				"          start_date,",
				"          end_date,",
				"          active_flag",
				"     )) ~> sink1",
				"alterRow2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          city as string,",
				"          start_date as date,",
				"          end_date as date,",
				"          active_flag as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:true,",
				"     upsertable:false,",
				"     keys:['id'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink2"
			]
		}
	}
}